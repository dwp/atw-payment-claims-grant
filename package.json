{
  "name": "govuk-prototype-kit",
  "description": "Rapidly create HTML prototypes of GOV.UK services",
  "version": "12.1.0",
  "private": true,
  "engines": {
    "node": ">=16.0.0 <17.0.0"
  },
  "scripts": {
    "start": "node start.js",
    "lint": "standard",
    "rapidtest": "jest --bail",
    "cypress:open": "cypress open",
    "test:integration": "start-server-and-test 3000 'cypress run'",
    "test:integration:edge": "start-server-and-test 3000 'cypress run --browser edge'",
    "test:integration:chrome": "start-server-and-test 3000 'cypress run --browser chrome'",
    "test:integration:electron": "start-server-and-test 3000 'cypress run --browser electron'",
    "test": "gulp generate-assets && jest && npm run lint"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "1.8.1",
    "acorn": "8.18.0",
    "ansi-colors": "4.1.3",
    "body-parser": "1.20.8",
    "browser-sync": "2.29.3",
    "client-sessions": "0.8.0",
    "cookie-parser": "1.4.7",
    "cross-spawn": "7.0.6",
    "del": "6.1.1",
    "dotenv": "10.0.0",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "fancy-log": "1.3.3",
    "govuk_frontend_toolkit": "7.6.0",
    "govuk_template_jinja": "0.24.1",
    "govuk-elements-sass": "3.1.3",
    "govuk-frontend": "4.10.1",
    "gray-matter": "4.0.3",
    "gulp": "4.0.2",
    "gulp-nodemon": "2.5.0",
    "gulp-sass": "5.1.0",
    "hmrc-frontend": "5.67.1",
    "inquirer": "8.2.7",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "nhsuk-frontend": "6.2.0",
    "notifications-node-client": "5.2.3",
    "nunjucks": "3.2.4",
    "portscanner": "2.2.0",
    "require-dir": "1.2.0",
    "sass": "1.105.0",
    "sync-request": "6.1.0",
    "universal-analytics": "0.4.23",
    "uuid": "^8.3.2"
  },
  "optionalDependencies": {
    "cypress": "9.7.0",
    "eslint-plugin-cypress": "2.15.2",
    "glob": "7.2.3",
    "jest": "27.5.1",
    "standard": "14.3.4",
    "start-server-and-test": "1.15.4",
    "supertest": "6.3.4",
    "wait-on": "6.0.1"
  },
  "standard": {
    "plugins": [
      "cypress"
    ],
    "env": {
      "cypress/globals": true
    }
  },
  "jest": {
    "testRunner": "jest-jasmine2"
  },
  "devDependencies": {
    "gulp-rename": "2.1.0"
  }
}
